import {
  AngularNodeAppEngine,
  createNodeRequestHandler,
  isMainModule,
  writeResponseToNodeResponse,
} from '@angular/ssr/node';
import express from 'express';
import { join } from 'node:path';

const browserDistFolder = join(import.meta.dirname, '../browser');

const app = express();

// Silence manifest warnings during development
const isDev = !process.env['NODE_ENV'] || process.env['NODE_ENV'] === 'development';

let angularApp: AngularNodeAppEngine | null = null;

async function initializeAngularApp() {
  if (angularApp) return angularApp;
  
  let originalError: any = null;
  if (isDev) {
    // In development, patch console.error temporarily
    originalError = console.error;
    console.error = (...args: any[]) => {
      if (args[0]?.includes?.('allowedHosts')) return;
      originalError(...args);
    };
  }

  try {
    angularApp = new AngularNodeAppEngine();
  } catch (error: any) {
    // If initialization fails due to manifest, continue anyway
    if (error?.message?.includes?.('allowedHosts')) {
      console.warn('Continuing without full SSR initialization due to manifest issue');
    } else {
      throw error;
    }
  } finally {
    if (isDev && originalError) {
      console.error = originalError;
    }
  }
  
  return angularApp;
}

// Pre-initialize to catch errors early
if (!isDev) {
  initializeAngularApp();
}

/**
 * Example Express Rest API endpoints can be defined here.
 * Uncomment and define endpoints as necessary.
 *
 * Example:
 * ```ts
 * app.get('/api/{*splat}', (req, res) => {
 *   // Handle API request
 * });
 * ```
 */

/**
 * Serve static files from /browser
 */
app.use(
  express.static(browserDistFolder, {
    maxAge: '1y',
    index: false,
    redirect: false,
  }),
);

/**
 * Handle all other requests by rendering the Angular application.
 */
app.use(async (req, res, next) => {
  try {
    const engine = await initializeAngularApp();
    if (!engine) {
      return next();
    }
    const response = await engine.handle(req);
    if (response) {
      writeResponseToNodeResponse(response, res);
    } else {
      next();
    }
  } catch (error) {
    next(error);
  }
});

/**
 * Start the server if this module is the main entry point, or it is ran via PM2.
 * The server listens on the port defined by the `PORT` environment variable, or defaults to 4000.
 */
if (isMainModule(import.meta.url) || process.env['pm_id']) {
  const port = process.env['PORT'] || 4000;
  app.listen(port, (error) => {
    if (error) {
      throw error;
    }

    console.log(`Node Express server listening on http://localhost:${port}`);
  });
}

/**
 * Request handler used by the Angular CLI (for dev-server and during build) or Firebase Cloud Functions.
 */
export const reqHandler = createNodeRequestHandler(app);
